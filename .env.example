DB_HOST=localhost
DB_PORT=3306
DB_NAME=sindhu
DB_USER=
DB_PASSWORD=
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENABLE_TEST_PAYMENTS=false
# Admin sign-in is always required. ADMIN_AUTH=off is a local-development escape hatch ONLY.
# ADMIN_AUTH=off
# Password-reset emails. Leave SMTP_HOST empty in development to print links to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sindhu's Pickles <support@sindhuspickles.com>"
# Cash on delivery is switched on/off in Admin → Settings → Payment methods. This flag is only the starting value until the owner first saves that page.
# ENABLE_COD=true
# Razorpay (see docs/RAZORPAY_INTEGRATION.md). Live additionally needs RAZORPAY_LIVE_APPROVED=true.
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
RAZORPAY_LIVE_APPROVED=false
# Secret for the scheduler that cancels stale unpaid orders: POST /api/store/payments/expire with "Authorization: Bearer <this>"
CRON_SECRET=
UNPAID_ORDER_EXPIRY_MINUTES=60
# Google Tag Manager container (the old site used GTM-NQWTTV9P). Loaded only when set.
NEXT_PUBLIC_GTM_ID=
# Set true on STAGING so search engines never index it.
NEXT_PUBLIC_NOINDEX=false
